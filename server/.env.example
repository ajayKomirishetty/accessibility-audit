PORT=3001

# "true" (default) = use canned demo responses, no API key needed.
# Set to "false" to call the real Anthropic API.
MOCK_MODE=true

ANTHROPIC_API_KEY=
# e.g. claude-sonnet-4-5
ANTHROPIC_MODEL=

# Optional: path to a Chrome/Chromium binary. Only needed if the Playwright
# browser download is blocked on your network (the server falls back to
# /opt/meta-chromium/chrome automatically when present).
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
